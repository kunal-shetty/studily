# ================= Studily Configuration (template) =================
# Copy this file to src/main/resources/application.properties and fill in
# your real values. The real file is gitignored so secrets stay local.
#   cp src/main/resources/application.properties.example src/main/resources/application.properties

# ---- Database (Supabase Postgres) ----
# RECOMMENDED: Session Pooler (works on IPv4 networks — new free projects
# are IPv6-only on db.*.supabase.co).
#   Supabase dashboard -> Connect -> Session pooler
#   URL:  jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres
#   User: postgres.<project-ref>
db.url=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres
db.user=postgres.<YOUR-PROJECT-REF>
db.password=YOUR_SUPABASE_DB_PASSWORD

# Direct connection (only works if your network supports IPv6):
# db.url=jdbc:postgresql://db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres
# db.user=postgres

# ---- Groq AI ----
# Free API key: https://console.groq.com/keys
groq.api.key=YOUR_GROQ_API_KEY_HERE
groq.model=llama-3.3-70b-versatile
groq.url=https://api.groq.com/openai/v1/chat/completions
groq.timeout.seconds=45

# ---- Uploads ----
upload.max.size.bytes=10485760

# ---- App ----
app.name=Studily
